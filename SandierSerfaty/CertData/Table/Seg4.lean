/-- The check of the chunk `c` of segment `4`. -/
abbrev SegP4 (c : Nat) : Prop :=
  chunkB (chunkLenAt 4) dLit nodeAt ctAt ntAt ckAt 4 (knotCell 4 + chunkLenAt 4 * c) = true

