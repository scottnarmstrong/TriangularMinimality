/-!
# Periodic Voronoi cells

Let `Γ` be a lattice of `ℂ` (`Submodule ℤ ℂ`, discrete and spanning) and `a : Fin n → ℂ` with
`a i - a j ∈ Γ → i = j`. The *periodic sites* are `periodicSites Γ a = {a i + γ | i, γ ∈ Γ}`, the full
`Γ`-periodic lift of `n` distinct points of the torus `ℂ / Γ`.

* the periodic sites are locally finite (`locallyFiniteSites_periodicSites`) and `Γ`-invariant;
* the cell of `p + γ` is the translate of the cell of `p` by `γ` (`mem_voronoiCell_periodicSites_add_iff`);
* with `latticeRadius Γ` a radius depending only on `Γ` such that every point is within
  `latticeRadius Γ` of `Γ`, every cell of a site lies in the ball of that radius about the site
  (`voronoiCell_subset_ball`), and is the intersection of the finitely many half-planes of the sites
  within distance `2 * latticeRadius Γ` (`voronoiCell_eq_biInter_near`); in particular it is a compact
  convex polygon;
* the union of the `n` representative cells is an a.e. fundamental domain of `Γ`
  (`isAddFundamentalDomain_voronoiRepresentatives`), so `∑ i, volume (cell (a i)) = covolume Γ`
  (`sum_volume_real_voronoiCell`), which is `n` for the lattice `squareLattice n`.

Source: paper §4, Lemma `geo:voronoi` (the paper does not argue
that the cells tile or that the total area is `n`).
-/

open MeasureTheory Metric Set
open scoped Pointwise

public section

namespace SandierSerfaty

/-- The `Γ`-periodic sites generated by `a : Fin n → ℂ`: all points `a i + γ` with `γ ∈ Γ`. -/
@[expose] def periodicSites (Γ : Submodule ℤ ℂ) {n : ℕ} (a : Fin n → ℂ) : Set ℂ :=
  {x | ∃ i, ∃ γ ∈ Γ, x = a i + γ}

section Sites

variable (Γ : Submodule ℤ ℂ) {n : ℕ} (a : Fin n → ℂ)

theorem mem_periodicSites_iff {x : ℂ} : x ∈ periodicSites Γ a ↔ ∃ i, x - a i ∈ Γ := by
  constructor
  · rintro ⟨i, γ, hγ, rfl⟩
    exact ⟨i, by simpa using hγ⟩
  · rintro ⟨i, h⟩
    exact ⟨i, _, h, by abel⟩

theorem mem_periodicSites (i : Fin n) : a i ∈ periodicSites Γ a :=
  ⟨i, 0, Γ.zero_mem, by simp⟩

theorem add_mem_periodicSites_iff {γ : ℂ} (hγ : γ ∈ Γ) {x : ℂ} :
    x + γ ∈ periodicSites Γ a ↔ x ∈ periodicSites Γ a := by
  simp only [mem_periodicSites_iff]
  refine exists_congr fun i => ?_
  have : x + γ - a i = (x - a i) + γ := by abel
  rw [this]
  exact ⟨fun h => by simpa using Γ.sub_mem h hγ, fun h => Γ.add_mem h hγ⟩

/-- The periodic sites are locally finite. -/
theorem locallyFiniteSites_periodicSites [DiscreteTopology Γ] :
    LocallyFiniteSites (periodicSites Γ a) := by
  intro x r
  have hcl : IsClosed (Γ : Set ℂ) :=
    AddSubgroup.isClosed_of_discreteTopology (U := Γ.toAddSubgroup)
  have hdisc : IsDiscrete (Γ : Set ℂ) := isDiscrete_iff_discreteTopology.2 inferInstance
  have hfin : ∀ i, (closedBall (x - a i) r ∩ (Γ : Set ℂ)).Finite := fun i =>
    Metric.finite_isBounded_inter_isClosed hdisc isBounded_closedBall hcl
  refine (Set.finite_iUnion fun i : Fin n => (hfin i).image fun γ => a i + γ).subset ?_
  rintro q ⟨⟨i, γ, hγ, rfl⟩, hq⟩
  simp only [mem_iUnion]
  refine ⟨i, γ, ⟨?_, hγ⟩, rfl⟩
  rw [mem_closedBall, dist_eq_norm] at hq ⊢
  convert hq using 2
  abel

/-- The cell of a translate of a site by a lattice vector is the translate of the cell. -/
theorem mem_voronoiCell_periodicSites_add_iff {γ : ℂ} (hγ : γ ∈ Γ) {p x : ℂ} :
    x ∈ voronoiCell (periodicSites Γ a) (p + γ) ↔ x - γ ∈ voronoiCell (periodicSites Γ a) p :=
  mem_voronoiCell_add_iff fun _ => add_mem_periodicSites_iff Γ a hγ

end Sites

section Radius

variable (Γ : Submodule ℤ ℂ) [DiscreteTopology Γ] [IsZLattice ℝ Γ]

theorem exists_forall_exists_mem_norm_sub_lt :
    ∃ R : ℝ, ∀ y : ℂ, ∃ γ ∈ Γ, ‖y - γ‖ < R := by
  have := ZLattice.module_free ℝ Γ
  have := ZLattice.module_finite ℝ Γ
  set b := Module.Free.chooseBasis ℤ Γ
  set B := b.ofZLatticeBasis ℝ
  obtain ⟨C, hC⟩ := isBounded_iff_forall_norm_le.1 (ZSpan.fundamentalDomain_isBounded B)
  refine ⟨C + 1, fun y => ⟨ZSpan.floor B y, ?_, ?_⟩⟩
  · have hspan : Submodule.span ℤ (range B) = Γ := Module.Basis.ofZLatticeBasis_span ℝ Γ b
    exact (SetLike.ext_iff.1 hspan _).1 (ZSpan.floor B y).2
  · have := hC _ (ZSpan.fract_mem_fundamentalDomain B y)
    simp only [ZSpan.fract] at this
    linarith

/-- A radius, depending only on the lattice `Γ`, such that every point of `ℂ` lies within distance
(strictly) less than `latticeRadius Γ` of a point of `Γ`. -/
@[expose] noncomputable def latticeRadius : ℝ :=
  Classical.choose (exists_forall_exists_mem_norm_sub_lt Γ)

theorem exists_mem_norm_sub_lt_latticeRadius (y : ℂ) : ∃ γ ∈ Γ, ‖y - γ‖ < latticeRadius Γ :=
  Classical.choose_spec (exists_forall_exists_mem_norm_sub_lt Γ) y

theorem latticeRadius_pos : 0 < latticeRadius Γ := by
  obtain ⟨γ, _, h⟩ := exists_mem_norm_sub_lt_latticeRadius Γ 0
  exact lt_of_le_of_lt (norm_nonneg _) h

end Radius

section Cells

variable (Γ : Submodule ℤ ℂ) [DiscreteTopology Γ] [IsZLattice ℝ Γ] {n : ℕ} (a : Fin n → ℂ)

/-- **Every cell lies in the ball of radius `latticeRadius Γ` about its site.** -/
theorem voronoiCell_subset_ball {p : ℂ} (hp : p ∈ periodicSites Γ a) :
    voronoiCell (periodicSites Γ a) p ⊆ ball p (latticeRadius Γ) := by
  intro x hx
  obtain ⟨γ, hγ, h⟩ := exists_mem_norm_sub_lt_latticeRadius Γ (x - p)
  have hq : p + γ ∈ periodicSites Γ a := (add_mem_periodicSites_iff Γ a hγ).2 hp
  have h1 := hx _ hq
  rw [mem_ball, dist_eq_norm]
  calc ‖x - p‖ ≤ ‖x - (p + γ)‖ := h1
    _ = ‖x - p - γ‖ := by congr 1; abel
    _ < _ := h

/-- A cell of a periodic configuration is compact. -/
theorem isCompact_voronoiCell {p : ℂ} (hp : p ∈ periodicSites Γ a) :
    IsCompact (voronoiCell (periodicSites Γ a) p) :=
  Metric.isCompact_of_isClosed_isBounded (isClosed_voronoiCell _ _)
    (isBounded_ball.subset (voronoiCell_subset_ball Γ a hp))

/-- **Every cell is cut out by the half-planes of the nearby sites.** The Voronoi cell of a site `p`
is the intersection of the half-planes bounded by the bisectors of `p` and the sites within distance
`2 * latticeRadius Γ`; there are finitely many such sites. -/
theorem voronoiCell_eq_biInter_near {p : ℂ} (hp : p ∈ periodicSites Γ a) :
    voronoiCell (periodicSites Γ a) p =
      ⋂ q ∈ periodicSites Γ a ∩ closedBall p (2 * latticeRadius Γ), bisectorHalfPlane p q := by
  set P := periodicSites Γ a with hP
  set R := latticeRadius Γ with hR
  have hRpos : 0 < R := latticeRadius_pos Γ
  set K : Set ℂ := ⋂ q ∈ P ∩ closedBall p (2 * R), bisectorHalfPlane p q with hK
  ext x
  constructor
  · intro hx
    simp only [hK, mem_iInter]
    exact fun q hq => hx q hq.1
  · intro hx
    have hKconv : Convex ℝ K :=
      convex_iInter fun q => convex_iInter fun _ => convex_bisectorHalfPlane p q
    have hpK : p ∈ K := by
      simp only [hK, mem_iInter]
      exact fun q _ => mem_bisectorHalfPlane_self p q
    -- near points of `K` lie in the cell
    have keyA : ∀ z ∈ K, ‖z - p‖ ≤ R → z ∈ voronoiCell P p := by
      intro z hz hzR q hq
      by_cases hq' : q ∈ closedBall p (2 * R)
      · simp only [hK, mem_iInter] at hz
        exact hz q ⟨hq, hq'⟩
      · rw [mem_closedBall, dist_eq_norm, not_le] at hq'
        have := norm_sub_le_norm_sub_add_norm_sub q z p
        rw [norm_sub_rev q z] at this
        linarith
    have hlt : ‖x - p‖ < R := by
      by_contra hge
      rw [not_lt] at hge
      have hxp : 0 < ‖x - p‖ := hRpos.trans_le hge
      set t : ℝ := R / ‖x - p‖ with ht
      have ht0 : 0 ≤ t := div_nonneg hRpos.le hxp.le
      have ht1 : t ≤ 1 := (div_le_one hxp).2 hge
      have hz : p + t • (x - p) ∈ K := hKconv.add_smul_sub_mem hpK hx ⟨ht0, ht1⟩
      have hzn : ‖p + t • (x - p) - p‖ = R := by
        rw [add_sub_cancel_left, norm_smul, Real.norm_of_nonneg ht0, ht]
        field_simp
      have hzc := keyA _ hz hzn.le
      have := voronoiCell_subset_ball Γ a hp hzc
      rw [mem_ball, dist_eq_norm, hzn] at this
      exact lt_irrefl _ this
    exact keyA x hx hlt.le

/-- The cell of a site of a periodic configuration is a finite intersection of closed half-planes
bounded by bisectors with other sites. -/
theorem exists_finite_biInter_voronoiCell {p : ℂ} (hp : p ∈ periodicSites Γ a) :
    ∃ S : Set ℂ, S.Finite ∧ S ⊆ periodicSites Γ a ∧
      voronoiCell (periodicSites Γ a) p = ⋂ q ∈ S, bisectorHalfPlane p q :=
  ⟨_, locallyFiniteSites_periodicSites Γ a p _, inter_subset_left,
    voronoiCell_eq_biInter_near Γ a hp⟩

end Cells

section Tiling

variable (Γ : Submodule ℤ ℂ) [DiscreteTopology Γ] [IsZLattice ℝ Γ] {n : ℕ} (a : Fin n → ℂ)

/-- The union of the `n` representative Voronoi cells, one for each `a i`. -/
@[expose] def voronoiRepresentatives : Set ℂ :=
  ⋃ i, voronoiCell (periodicSites Γ a) (a i)

omit [DiscreteTopology Γ] [IsZLattice ℝ Γ] in
theorem mem_vadd_voronoiRepresentatives_iff (g : Γ) (x : ℂ) :
    x ∈ g +ᵥ voronoiRepresentatives Γ a ↔
      ∃ i, x ∈ voronoiCell (periodicSites Γ a) (a i + g) := by
  rw [Set.mem_vadd_set_iff_neg_vadd_mem]
  have : (-g) +ᵥ x = x - g := by
    show ((-g : Γ) : ℂ) + x = x - g
    simp [sub_eq_neg_add]
  rw [this, voronoiRepresentatives, mem_iUnion]
  refine exists_congr fun i => ?_
  rw [mem_voronoiCell_periodicSites_add_iff Γ a g.2]

omit [IsZLattice ℝ Γ] in
/-- **The representative cells form an a.e. fundamental domain of `Γ`.** -/
theorem isAddFundamentalDomain_voronoiRepresentatives [NeZero n]
    (ha : ∀ i j, a i - a j ∈ Γ → i = j) :
    IsAddFundamentalDomain Γ (voronoiRepresentatives Γ a) volume := by
  have hfin := locallyFiniteSites_periodicSites Γ a
  refine ⟨(MeasurableSet.iUnion fun i => measurableSet_voronoiCell _ _).nullMeasurableSet,
    Filter.Eventually.of_forall fun x => ?_, fun g g' hgg' => ?_⟩
  · obtain ⟨p, hp, hx⟩ :=
      exists_mem_voronoiCell ⟨a 0, mem_periodicSites Γ a 0⟩ hfin x
    obtain ⟨i, γ, hγ, rfl⟩ := hp
    refine ⟨⟨-γ, Γ.neg_mem hγ⟩, ?_⟩
    rw [voronoiRepresentatives, mem_iUnion]
    refine ⟨i, ?_⟩
    have := (mem_voronoiCell_periodicSites_add_iff Γ a hγ).1 hx
    show (-γ) + x ∈ _
    rwa [neg_add_eq_sub]
  · show volume ((g +ᵥ voronoiRepresentatives Γ a) ∩ (g' +ᵥ voronoiRepresentatives Γ a)) = 0
    have hsub : (g +ᵥ voronoiRepresentatives Γ a) ∩ (g' +ᵥ voronoiRepresentatives Γ a) ⊆
        ⋃ i, ⋃ j, voronoiCell (periodicSites Γ a) (a i + g) ∩
          voronoiCell (periodicSites Γ a) (a j + g') := by
      rintro x ⟨h1, h2⟩
      obtain ⟨i, hi⟩ := (mem_vadd_voronoiRepresentatives_iff Γ a g x).1 h1
      obtain ⟨j, hj⟩ := (mem_vadd_voronoiRepresentatives_iff Γ a g' x).1 h2
      exact mem_iUnion₂.2 ⟨i, j, hi, hj⟩
    refine measure_mono_null hsub (measure_iUnion_null fun i => measure_iUnion_null fun j => ?_)
    have hmem : ∀ (k : Fin n) (h : Γ), (a k + h) ∈ periodicSites Γ a := fun k h =>
      (add_mem_periodicSites_iff Γ a h.2).2 (mem_periodicSites Γ a k)
    refine volume_voronoiCell_inter_eq_zero (hmem i g) (hmem j g') fun heq => hgg' ?_
    have hij : i = j := ha i j (by
      have : a i - a j = (g' : ℂ) - g := by linear_combination heq
      rw [this]; exact Γ.sub_mem g'.2 g.2)
    subst hij
    exact Subtype.ext (add_left_cancel heq)

omit [DiscreteTopology Γ] [IsZLattice ℝ Γ] in
/-- The total volume of the `n` representative cells. -/
theorem volume_voronoiRepresentatives [NeZero n] (ha : ∀ i j, a i - a j ∈ Γ → i = j) :
    volume (voronoiRepresentatives Γ a) = ∑ i, volume (voronoiCell (periodicSites Γ a) (a i)) := by
  rw [voronoiRepresentatives, measure_iUnion₀, tsum_fintype]
  · intro i j hij
    refine aedisjoint_voronoiCell (mem_periodicSites Γ a i) (mem_periodicSites Γ a j) fun h => hij ?_
    exact ha i j (by simp [h])
  · exact fun i => (measurableSet_voronoiCell _ _).nullMeasurableSet

/-- **Total area of the Voronoi cells.** For a configuration of `n ≠ 0` points distinct modulo `Γ`,
the areas of the `n` representative cells add up to the covolume of `Γ`. -/
theorem sum_volume_real_voronoiCell [NeZero n] (ha : ∀ i j, a i - a j ∈ Γ → i = j) :
    ∑ i, volume.real (voronoiCell (periodicSites Γ a) (a i)) = ZLattice.covolume Γ := by
  rw [ZLattice.covolume_eq_measure_fundamentalDomain Γ volume
    (isAddFundamentalDomain_voronoiRepresentatives Γ a ha), measureReal_def,
    volume_voronoiRepresentatives Γ a ha, ENNReal.toReal_sum]
  · simp [measureReal_def]
  · exact fun i _ => (isCompact_voronoiCell Γ a (mem_periodicSites Γ a i)).measure_lt_top.ne

end Tiling

